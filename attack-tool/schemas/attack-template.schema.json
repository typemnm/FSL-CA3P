{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CA3P declarative attack packet template",
  "$comment": "Registration also requires at most 64 KiB of compact UTF-8 JSON, payload/baseline strings at most 4096 UTF-8 bytes, canonical paths, and matching target/packet method and path. Unimplemented verifier modes remain reference-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["templateId", "attackType", "dependency", "target", "request", "blanks", "payloads", "verify", "executor", "trust"],
  "properties": {
    "templateId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "attackType": {
      "type": "object", "additionalProperties": false, "required": ["name", "cwe"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 },
        "cwe": { "type": "string", "pattern": "^CWE-[1-9][0-9]{0,6}$" }
      }
    },
    "dependency": {
      "type": "object", "additionalProperties": false, "required": ["runtime", "framework", "library"],
      "properties": {
        "runtime": { "$ref": "#/$defs/dependency" },
        "framework": { "$ref": "#/$defs/dependency" },
        "library": { "$ref": "#/$defs/dependency" }
      }
    },
    "sessionRole": { "type": "string", "enum": ["public", "student", "owner", "admin"] },
    "fixtures": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$" }
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["method", "endpoint"],
      "properties": { "method": { "$ref": "#/$defs/method" }, "endpoint": { "$ref": "#/$defs/path" } }
    },
    "request": {
      "type": "object", "additionalProperties": false, "required": ["packet"],
      "properties": {
        "packet": {
          "type": "object", "additionalProperties": false, "required": ["method", "path"],
          "properties": {
            "method": { "$ref": "#/$defs/method" }, "path": { "$ref": "#/$defs/path" },
            "query": { "$ref": "#/$defs/stringMap" }, "body": { "$ref": "#/$defs/stringMap" }
          }
        }
      }
    },
    "blanks": {
      "type": "object", "additionalProperties": false, "required": ["origin", "payload"],
      "properties": {
        "origin": {
          "type": "object", "additionalProperties": false, "required": ["required", "type"],
          "properties": { "required": { "const": true }, "type": { "const": "url" }, "desc": { "type": "string", "maxLength": 1000 } }
        },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["required", "type", "pickFrom"],
          "properties": { "required": { "const": true }, "type": { "const": "string" }, "pickFrom": { "const": "payloads" }, "desc": { "type": "string", "maxLength": 1000 } }
        }
      }
    },
    "payloads": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 4096 } },
    "verify": {
      "type": "object", "additionalProperties": false, "required": ["mode", "baseline", "attack"],
      "properties": {
        "mode": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
        "baseline": { "$ref": "#/$defs/verifySide" },
        "attack": { "$ref": "#/$defs/verifySide" },
        "followUp": { "$ref": "#/$defs/verifySide" }
      }
    },
    "executor": { "const": "guardrail" },
    "trust": { "const": "unverified" }
  },
  "$defs": {
    "dependency": { "type": "string", "minLength": 1, "maxLength": 128 },
    "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
    "path": { "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^/(?!/)[^?#\\\\\\s%]*$" },
    "stringMap": { "type": "object", "maxProperties": 20, "propertyNames": { "pattern": "^[A-Za-z0-9_.-]{1,128}$" }, "additionalProperties": { "type": "string", "maxLength": 4096 } },
    "count": { "type": "integer", "minimum": 0, "maximum": 1000000 },
    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
    "verifySide": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "q": { "type": "string", "maxLength": 4096 },
        "expect": { "$ref": "#/$defs/count" },
        "expectMin": { "$ref": "#/$defs/count" },
        "status": { "$ref": "#/$defs/status" },
        "contains": { "type": "string", "maxLength": 4096 },
        "method": { "$ref": "#/$defs/method" },
        "path": { "$ref": "#/$defs/path" },
        "query": { "$ref": "#/$defs/stringMap" },
        "body": { "$ref": "#/$defs/stringMap" },
        "fields": {
          "type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    }
  }
}

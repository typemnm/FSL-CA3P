{
  "templateId": "ssti-query-template",
  "title": "검색 질의 템플릿 주입 canary",
  "sessionRole": "public",
  "attackType": { "name": "template_injection", "cwe": "CWE-1336" },
  "dependency": { "runtime": "node", "framework": "express", "library": "nunjucks" },
  "target": { "method": "GET", "endpoint": "/api/search" },
  "request": { "packet": { "method": "GET", "path": "/api/search", "query": { "q": "{{payload}}" } } },

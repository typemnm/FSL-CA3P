  "payloads": ["{{7*7}}"],
  "verify": {
    "mode": "textContains",
    "baseline": { "status": 200, "query": { "q": "zzqnomatch" } },
    "attack": { "status": 200, "contains": "49" }
  },
  "executor": "guardrail",
  "trust": "unverified"
}

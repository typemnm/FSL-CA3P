{
  "templateId": "search-sqli-template",
  "title": "검색 SQL Injection 점검",
  "sessionRole": "public",
  "attackType": {
    "name": "sql_injection",
    "cwe": "CWE-89"
  },
  "dependency": {
    "runtime": "node",
    "framework": "express",
    "library": "node:sqlite"
  },
  "target": {
    "method": "GET",
    "endpoint": "/api/search"
  },
  "request": {
    "packet": {
      "method": "GET",
      "path": "/api/search",
      "query": {
        "q": "{{payload}}"
      }
    }
  },
  "blanks": {
    "origin": {
      "required": true,
      "type": "url"
    },
    "payload": {
      "required": true,
      "type": "string",
      "pickFrom": "payloads"
    }
  },
  "payloads": [
    "' OR '1'='1"
  ],
  "verify": {
    "mode": "resultCount",
    "baseline": {
      "q": "zzqnomatch",
      "expect": 0
    },
    "attack": {
      "expectMin": 1
    }
  },
  "executor": "guardrail",
  "trust": "unverified"
}

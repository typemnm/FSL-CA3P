{
  "name": "fictional-university-pair",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Two fictional university websites for an isolated security evaluation",
  "scripts": {
    "start": "docker compose up --build",
    "start:daehan": "node src/server.mjs daehan",
    "start:wonchang": "docker compose up --build wonchang",
    "smoke": "node scripts/smoke.mjs",
    "probe:idor": "node scripts/idor-probe.mjs",
    "test:idor": "node --test tests/idor-probe.test.mjs",
    "test:reset": "node --test tests/daehan-reset-supervisor.test.mjs"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "dayjs": "1.11.13",
    "express": "4.21.2",
    "json5": "2.2.1",
    "lodash": "4.17.15",
    "markdown-it": "12.3.1",
    "nunjucks": "3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}

<%- include('partials/header', { pageTitle: heading + ' | ' + site.name }) %>
<section class="page-hero"><div class="container"><nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">/</span><span><%= heading %></span></nav><span class="eyebrow">CAMPUS COMMUNICATION</span><h1><%= heading %></h1><p><%= intro %></p></div></section>
<section class="content-section"><div class="container">
  <div class="board-tools"><p>등록된 <%= heading %>을 확인하세요.</p><form class="board-search" action="<%= activePath %>" method="get" role="search"><label class="sr-only" for="board-q"><%= heading %> 검색</label><input type="search" id="board-q" name="q" value="<%= q || '' %>" placeholder="제목 검색"><button type="submit" aria-label="검색">검색</button></form></div>
  <div class="board-list"><div class="board-heading"><span>구분</span><span>제목</span><span>작성일</span></div><% for (const item of posts) { %><a class="board-row" href="/<%= type === 'news' ? 'news' : 'notices' %>/<%= item.id %>"><span class="board-category"><%= type === 'news' ? '대학 소식' : '공지사항' %></span><span class="board-title"><%= item.title %><small><%= String(item.body || '').length > 86 ? String(item.body).slice(0, 86) + '...' : item.body %></small></span><time><%= item.created_at %></time><span class="board-row-arrow" aria-hidden="true">↗</span></a><% } %><% if (!posts.length) { %><p class="empty-state"><% if (q) { %>“<%= q %>”에 대한 검색 결과가 없습니다.<% } else { %>등록된 게시물이 없습니다.<% } %></p><% } %></div>
  <% if (totalPages && totalPages > 1) { %><nav class="pagination" aria-label="페이지 이동"><% if (page > 1) { %><a href="<%= activePath %>?q=<%= encodeURIComponent(q || '') %>&page=<%= page - 1 %>" aria-label="이전 페이지">←</a><% } %><% for (let n = 1; n <= totalPages; n++) { %><a href="<%= activePath %>?q=<%= encodeURIComponent(q || '') %>&page=<%= n %>" <% if (n === page) { %>aria-current="page"<% } %>><%= n %></a><% } %><% if (page < totalPages) { %><a href="<%= activePath %>?q=<%= encodeURIComponent(q || '') %>&page=<%= page + 1 %>" aria-label="다음 페이지">→</a><% } %></nav><% } %>
</div></section>
<%- include('partials/footer') %>

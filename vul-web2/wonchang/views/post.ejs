<%- include('partials/header', { pageTitle: post.title + ' | ' + site.name }) %>
<section class="page-hero page-hero-compact"><div class="container"><nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">/</span><a href="/<%= post.type === 'news' ? 'news' : 'notices' %>"><%= post.type === 'news' ? '대학 소식' : '공지사항' %></a><span aria-hidden="true">/</span><span>상세 보기</span></nav><span class="eyebrow"><%= site.enName %></span><h1><%= post.type === 'news' ? '대학 소식' : '공지사항' %></h1></div></section>
<article class="content-section"><div class="container article-container"><div class="article-head"><span class="pill"><%= post.type === 'news' ? '대학 소식' : '공지사항' %></span><h2><%= post.title %></h2><div class="article-meta"><span><%= post.author || site.name %></span><time><%= post.created_at %></time><span>조회 <%= post.views || 0 %></span></div></div><div class="article-body"><%= post.body %></div><div class="article-actions"><a class="button button-dark" href="/<%= post.type === 'news' ? 'news' : 'notices' %>">목록으로</a><% if (user && user.role === 'admin') { %><a class="button button-line" href="/admin/posts/<%= post.id %>/edit">수정하기</a><% } %></div></div></article>
<%- include('partials/footer') %>

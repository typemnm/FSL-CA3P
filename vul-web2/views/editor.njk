{% extends "layout.njk" %}
{% block title %}{% if post %}게시물 수정{% else %}새 글 작성{% endif %} | {{ site.name }}{% endblock %}
{% block main %}
<section class="page-hero page-hero-compact"><div class="container"><nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true">/</span><a href="/admin">관리자</a><span aria-hidden="true">/</span><span>{% if post %}게시물 수정{% else %}새 글 작성{% endif %}</span></nav><span class="eyebrow">CONTENT MANAGEMENT</span><h1>{% if post %}게시물 수정{% else %}새 글 작성{% endif %}</h1></div></section>
<section class="content-section"><div class="container editor-container"><div class="editor-heading"><h2>게시물 정보</h2><p>제목과 내용을 입력한 뒤 저장하세요.</p></div>{% if error %}<div class="form-error" role="alert">{{ error }}</div>{% endif %}<form action="{% if post %}/admin/posts/{{ post.id }}{% else %}/admin/posts{% endif %}" method="post" class="editor-form"><div class="form-field"><label for="post-type">게시판</label><select id="post-type" name="type" required><option value="notice" {% if not post or post.type == 'notice' %}selected{% endif %}>공지사항</option><option value="news" {% if post and post.type == 'news' %}selected{% endif %}>대학 소식</option></select></div><div class="form-field"><label for="post-title">제목</label><input id="post-title" name="title" maxlength="200" value="{{ post.title if post else '' }}" placeholder="제목을 입력하세요" required></div><div class="form-field"><label for="post-body">내용</label><textarea id="post-body" name="body" rows="16" placeholder="내용을 입력하세요" required>{{ post.body if post else '' }}</textarea></div><div class="form-actions"><a class="button button-line" href="/admin">취소</a><button class="button button-primary" type="submit">{% if post %}수정 사항 저장{% else %}게시물 등록{% endif %}</button></div></form></div></section>
{% endblock %}

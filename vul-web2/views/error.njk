{% extends "layout.njk" %}
{% block title %}{{ status or 500 }} 오류 | {{ site.name }}{% endblock %}
{% block main %}
<section class="error-section"><div class="container error-inner"><span class="error-code">{{ status or 500 }}</span><span class="eyebrow">SERVICE INFORMATION</span><h1>{% if status == 404 %}페이지를 찾을 수 없습니다.{% else %}서비스 이용에 불편을 드려 죄송합니다.{% endif %}</h1><p>{{ message or '요청하신 페이지를 표시할 수 없습니다. 잠시 후 다시 시도해 주세요.' }}</p><div class="error-actions"><a class="button button-primary" href="/">홈으로 돌아가기</a><a class="button button-line" href="/faq">이용 안내</a></div>{% if stack %}<pre class="error-stack">{{ stack }}</pre>{% endif %}</div></section>
{% endblock %}

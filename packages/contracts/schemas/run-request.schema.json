{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ca3p.local/contracts/run-request/1.0",
  "title": "CA3P lab or external observation request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "mode": {"enum": ["local-lab-rule", "local-lab-general", "external-general"]},
    "modelId": {"type": "string", "pattern": "^(rule-baseline|deepseek-flash|deepseek-v4-pro|local-llm|custom-[a-f0-9]{12})$"},
    "fixtureId": {"enum": ["vul-web-1", "vul-web2-daehan", "vul-web2-wonchang"]},
    "target": {"type": "string", "maxLength": 2048},
    "delayMs": {"type": "integer", "minimum": 0, "maximum": 3000},
    "testProfile": {"enum": ["known_record_idor_read", "general"]},
    "scope": {"type": "object", "additionalProperties": false,
      "properties": {"pathPrefix": {"type": "string", "maxLength": 1024, "pattern": "^/"}}},
    "preflightToken": {"type": "string", "maxLength": 4096},
    "authorizationConfirmed": {"type": "boolean"},
    "approvalRequired": {"type": "boolean"},
    "multiAgent": {"type": "object", "additionalProperties": false, "required": ["enabled"],
      "properties": {"enabled": {"const": true},
        "maxConcurrentAgents": {"type": "integer", "minimum": 1, "maximum": 2},
        "maxTasks": {"type": "integer", "minimum": 1, "maximum": 4},
        "maxTargetRequests": {"type": "integer", "minimum": 1, "maximum": 224},
        "maxModelRequests": {"type": "integer", "minimum": 1, "maximum": 160},
        "maxModelTokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "deadlineMs": {"type": "integer", "minimum": 1000, "maximum": 1800000}}}
  },
  "allOf": [
    {"if": {"not": {"properties": {"fixtureId": {"enum": ["vul-web2-daehan", "vul-web2-wonchang"]}}, "required": ["fixtureId"]}},
      "then": {"if": {"properties": {"mode": {"enum": ["local-lab-rule", "local-lab-general"]}}, "required": ["mode"]},
        "then": {"not": {"required": ["target"]}}}},
    {"if": {"properties": {"fixtureId": {"enum": ["vul-web2-daehan", "vul-web2-wonchang"]}}, "required": ["fixtureId"]},
      "then": {"properties": {"mode": {"enum": ["local-lab-rule", "local-lab-general"]}}}},
    {"if": {"properties": {"mode": {"const": "local-lab-rule"}}, "required": ["mode"]},
      "then": {"required": ["fixtureId"], "properties": {"fixtureId": {"enum": ["vul-web2-daehan", "vul-web2-wonchang"]}}}},
    {"if": {"properties": {"mode": {"const": "local-lab-general"}}, "required": ["mode"]},
      "then": {"properties": {"modelId": {"type": "string", "pattern": "^(deepseek-flash|deepseek-v4-pro|local-llm|custom-[a-f0-9]{12})$"}, "testProfile": {"const": "general"}}},
      "else": {"properties": {"testProfile": {"not": {"const": "general"}}}}},
    {"if": {"required": ["multiAgent"]},
      "then": {"required": ["mode"], "properties": {"mode": {"enum": ["local-lab-general", "external-general"]}}}},
    {"if": {"properties": {"mode": {"const": "external-general"}}, "required": ["mode"]},
      "then": {"required": ["target", "preflightToken", "authorizationConfirmed"],
        "properties": {"modelId": {"type": "string", "pattern": "^(deepseek-flash|deepseek-v4-pro|local-llm|custom-[a-f0-9]{12})$"}, "authorizationConfirmed": {"const": true}},
        "not": {"anyOf": [{"required": ["fixtureId"]}, {"required": ["testProfile"]},
          {"required": ["delayMs"]}, {"required": ["approvalRequired"]}]}},
      "else": {"not": {"anyOf": [{"required": ["scope"]}, {"required": ["preflightToken"]},
        {"required": ["authorizationConfirmed"]}]}}}
  ]
}

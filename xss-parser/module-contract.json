{
  "moduleId": "web-parser",
  "packageName": "web-parser",
  "entryPoint": "parser.mjs",
  "export": "scan",
  "identityExport": "MODULE_ID",
  "inputs": {"required": ["url"], "scope": "http(s)-loopback-same-origin"},
  "outputs": {"default": "3.4", "structure": "structure-1.0", "identityField": "moduleId"},
  "capabilities": ["web-structure", "url-library-indicators", "web-resource-relations", "optional-local-inventory"],
  "vulnerabilityMatching": false,
  "consumerMigrationComplete": false,
  "consumerActions": ["Update module registry and sender/receiver allowlist", "Update dashboard label and routing", "Coordinate physical directory and import-path migration separately"],
  "notes": "This descriptor does not modify the external Agent protocol or dashboard registry."
}
